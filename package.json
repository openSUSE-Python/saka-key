{
  "name": "saka-key",
  "description": "A keyboard interface to the web",
  "scripts": {
    "clean": "rimraf dist",
    "test": "echo \"Error: no test specified\" && exit 1",
    "start:chrome": "webpack --mode=development --watch --env=chrome",
    "start:firefox": "webpack --mode=development --watch --env=firefox",
    "build:chrome": "webpack --mode=production --env=chrome",
    "build:firefox": "webpack --mode=production --env=firefox",
    "zip-chrome-prod": "zip -r -j -FS chrome-prod.zip dist/*",
    "zip-firefox-prod": "zip -r -j -FS firefox-prod.zip dist/*",
    "zip-chrome-debug": "zip -r -j -FS chrome-debug.zip dist/*",
    "zip-firefox-debug": "zip -r -j -FS firefox-debug.zip dist/*",
    "release": "npm run build:chrome && npm run zip-chrome-debug && npm run build:firefox && npm run zip-firefox-debug && npm run build:chrome && npm run zip-chrome-prod && npm run build:firefox && npm run zip-firefox-prod",
    "prepare": "husky"
  },
  "browserslist": [
    "last 2 chrome version",
    "last 2 firefox version"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lusakasa/saka-key.git"
  },
  "license": "MIT",
  "devDependencies": {
    "@babel/preset-react": "^7.24.1",
    "@types/chrome": "^0.1.24",
    "@types/firefox-webext-browser": "^120.0.0",
    "babel-loader": "^9.1.3",
    "copy-webpack-plugin": "^12.0.2",
    "css-loader": "^7.1.1",
    "eslint": "^8.57.0",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^6.1.1",
    "eslint-plugin-react": "^7.34.1",
    "generate-json-webpack-plugin": "^2.0.0",
    "html-loader": "^5.0.0",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.2",
    "markdown-loader": "^8.0.0",
    "prettier": "^3.2.5",
    "rimraf": "^5.0.5",
    "sass": "^1.93.2",
    "sass-loader": "^16.0.5",
    "style-loader": "^4.0.0",
    "webpack": "^5.91.0",
    "webpack-cli": "^5.1.4",
    "webpack-merge": "^5.10.0"
  },
  "dependencies": {
    "@babel/core": "^7.24.5",
    "@babel/plugin-transform-class-properties": "^7.24.1",
    "@babel/preset-env": "^7.24.5",
    "compare-versions": "^6.1.0",
    "marked": "^12.0.2",
    "material-components-web": "^14.0.0",
    "mosi": "^1.6.0",
    "preact": "^10.22.0",
    "react-redux": "^9.1.2",
    "redux": "^5.0.1",
    "redux-logger": "^3.0.6",
    "redux-thunk": "^3.1.0",
    "smoothscroll-polyfill": "^0.4.4",
    "webextension-polyfill": "^0.12.0"
  }
}
